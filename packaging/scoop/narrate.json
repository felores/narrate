{
  "version": "0.5.2",
  "description": "Provider-agnostic TTS gateway and CLI for AI coding harnesses",
  "homepage": "https://github.com/felores/narrate",
  "license": "MIT",
  "depends": "main/bun",
  "url": "https://github.com/felores/narrate/archive/refs/tags/v0.5.2.tar.gz",
  "hash": "7a91e3bb26f2349381e509f7afbbbbdf2bbf6b8b2b86913ecdc32eec9a28bbaa",
  "extract_dir": "narrate-0.5.2",
  "pre_install": [
    "Set-Content -Encoding Ascii -Path \"$dir\\narrate.cmd\" -Value '@bun run \"%~dp0src\\cli.ts\" %*'",
    "Set-Content -Encoding Ascii -Path \"$dir\\narrate-server.cmd\" -Value '@bun run \"%~dp0src\\server.ts\" %*'"
  ],
  "bin": [
    "narrate.cmd",
    "narrate-server.cmd"
  ],
  "post_install": [
    "Push-Location \"$dir\"; bun install --frozen-lockfile; Pop-Location"
  ],
  "notes": [
    "narrate is installed. Start the server with:  narrate-server",
    "Then speak with:  narrate \"hello from Windows\"",
    "The system provider uses Windows SAPI (System.Speech) - no API key needed.",
    "For premium voices add keys to %USERPROFILE%\\.env (ELEVENLABS_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, XAI_API_KEY, SONIOX_API_KEY, FISH_AUDIO_API_KEY).",
    "Auto-start at login (one command):",
    "  powershell -ExecutionPolicy Bypass -File \"$(scoop prefix narrate)\\packaging\\scoop\\install-service.ps1\""
  ],
  "checkver": "github",
  "autoupdate": {
    "url": "https://github.com/felores/narrate/archive/refs/tags/v$version.tar.gz",
    "extract_dir": "narrate-$version"
  }
}
