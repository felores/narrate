[Unit]
Description=narrate TTS gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=__NARRATE_DIR__
ExecStart=__PROGRAM_ARGS__
Restart=on-failure
RestartSec=5
# systemd-only: captures pre-init startup output + crashes.
# The real per-request log is logs/narrate.log written by the
# in-process rotating logger (src/logger.ts).
StandardOutput=append:__NARRATE_DIR__/logs/launchd-stdout.log
StandardError=append:__NARRATE_DIR__/logs/launchd-stderr.log
Environment=HOME=__HOME__
Environment=PATH=__PATH_VALUE__
# Compiled binaries self-locate logs/data via NARRATE_DIR (source mode
# ignores it — see src/server.ts compiled detection).
Environment=NARRATE_DIR=__NARRATE_DIR__

[Install]
WantedBy=default.target
